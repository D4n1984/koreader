<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Layout: 3x2 Reading Progress Display -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@android:color/white">

    <!-- Book Slot 1 (Left) -->
    <FrameLayout
        android:id="@+id/book1_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_slot_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Book Title (max 2 lines) -->
            <TextView
                android:id="@+id/book1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="2dp" />

            <!-- Author -->
            <TextView
                android:id="@+id/book1_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unknown"
                android:textSize="8sp"
                android:textColor="@android:color/darker_gray"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Progress Bar -->
            <ImageView
                android:id="@+id/book1_progress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:scaleType="fitXY"
                android:layout_marginBottom="4dp"
                android:contentDescription="Reading progress bar" />

            <!-- Percentage + Last Read Time (horizontal layout) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="space-between">

                <TextView
                    android:id="@+id/book1_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/book1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N/A"
                    android:textSize="8sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Book Slot 2 (Right) -->
    <FrameLayout
        android:id="@+id/book2_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_slot_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Book Title (max 2 lines) -->
            <TextView
                android:id="@+id/book2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="2dp" />

            <!-- Author -->
            <TextView
                android:id="@+id/book2_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unknown"
                android:textSize="8sp"
                android:textColor="@android:color/darker_gray"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Progress Bar -->
            <ImageView
                android:id="@+id/book2_progress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:scaleType="fitXY"
                android:layout_marginBottom="4dp"
                android:contentDescription="Reading progress bar" />

            <!-- Percentage + Last Read Time (horizontal layout) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="space-between">

                <TextView
                    android:id="@+id/book2_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/book2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N/A"
                    android:textSize="8sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
